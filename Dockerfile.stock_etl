FROM python:3.11.15-trixie

RUN apt-get update && apt-get install -y gcc curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 复制整个 workspace（uv 需要解析所有成员包）
COPY pyproject.toml uv.lock ./
COPY packages/shared ./packages/shared
COPY src ./src

RUN uv sync --package stock_etl --no-dev

# fastembed 模型缓存目录
ENV FASTEMBED_CACHE_PATH=/opt/fastembed_cache

# build 阶段下载 BM25 模型
RUN uv run python - <<'PY'
from fastembed import SparseTextEmbedding

model = SparseTextEmbedding(model_name="Qdrant/bm25")
list(model.embed(["warmup"]))
print("fastembed bm25 model downloaded")
PY

WORKDIR /app/src/stock_etl
EXPOSE 8011
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8011"]
