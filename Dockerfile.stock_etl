FROM python:3.11.15-trixie

RUN apt-get update && apt-get install -y gcc curl && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 先复制项目配置文件，让 uv 能识别项目
COPY ./packages/shared ./packages/shared
COPY ./src/stock_etl ./src/stock_etl
COPY pyproject.toml ./pyproject.toml

# 重要：进入正确的 package 目录执行 sync
RUN uv sync

# fastembed模型缓存目录
ENV FASTEMBED_CACHE_PATH=/opt/fastembed_cache

# build阶段下载BM25模型
RUN uv run python - <<'PY'
from fastembed import SparseTextEmbedding

model = SparseTextEmbedding(
    model_name="Qdrant/bm25"
)

list(model.embed(["warmup"]))

print("fastembed bm25 model downloaded")
PY

# 暴露端口
EXPOSE 8011

WORKDIR /app/src/stock_etl

# 启动命令（推荐用 module 方式启动，更稳定）
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8011", "--reload"]
