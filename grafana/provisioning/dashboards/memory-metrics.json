  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "stock-agent",
    "memory"
  ],
  "templating": {
    "list": [
      {
        "name": "operation",
        "label": "操作",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(memory_operations_total, operation)",
        "definition": "label_values(memory_operations_total, operation)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "memory_type",
        "label": "记忆类型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(memory_writes_total, memory_type)",
        "definition": "label_values(memory_writes_total, memory_type)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "utc",
  "title": "Memory",
  "uid": "memory-metrics",
