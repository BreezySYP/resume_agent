# 配置优先级：真实环境变量（容器 -e / compose environment / env_file） > .env > 代码默认值。
# 容器部署时无需把本文件放进镜像，直接用 compose 的 environment 或 env_file 注入即可。
# 下面的值全部是占位/示例，敏感键（API_KEY / TOKEN / PASSWORD）只能放占位符。

# APP
ENV=dev
NAME=your-app-name

# LLM
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:14b
LLM_SQL=qwen2.5-coder:14b
EMBED_MODEL=bge-m3
GROQ_API_KEY=xxx
DEEP_SEEK_KEY=sk-xxxxxxxxx

# Redis
REDIS_URL=redis://redis:6379
VS_INDEX_NAME=multi_agent_rag

# MySQL
MYSQL_USER=agent
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=changeit
MYSQL_URL=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=mydb

# MinIO
MINIO_URL=http://minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeit
MINIO_BUCKET=skills

# Observability
TEMPO_URL=http://tempo:4317
LOKI_URL=http://loki:3100
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
OTEL_SERVICE_NAME=stock-agent

# Web
# CORS_ORIGINS 必须是 JSON 数组格式，例如 ["*"] 或 ["https://a.example.com"]
CORS_ORIGINS=["*"]

# Auth（GitHub OAuth + JWT Bearer token，独立 auth_service）
# 在 https://github.com/settings/developers 注册 OAuth App，Authorization callback URL 填 AUTH_REDIRECT_URI
# 只有 auth_service 需要 GITHUB_OAUTH_* / AUTH_REDIRECT_URI / Redis / JWT 私钥；
# 其他 API 服务只用公钥离线验签（拿不到签发能力）
GITHUB_OAUTH_CLIENT_ID=xxx
GITHUB_OAUTH_CLIENT_SECRET=xxx
AUTH_REDIRECT_URI=http://localhost:8016/api/auth/callback/github
# RS256 私钥（base64 编码的 PEM），仅 auth_service 配置：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
AUTH_JWT_PRIVATE_KEY_B64=xxx
# 验签公钥（base64 PEM）：各 API 服务用它离线验签，无网络请求、无缓存
# 生成：openssl pkey -pubout <私钥> | base64 -w0
AUTH_JWT_PUBLIC_KEY_B64=
AUTH_SESSION_DAYS=7
# 登录 code 有效期（秒），回调只带 code，前端再用 code 换 token
AUTH_LOGIN_CODE_TTL=60
# 逗号分隔的 GitHub login；命中者登录后自动成为管理员
AUTH_ADMIN_GITHUB_LOGINS=
# 登录成功后跳回的前端页面白名单（JSON 数组）；回调 302 到该地址并带 ?code=...
AUTH_FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=xxx
LANGCHAIN_PROJECT=default

# Tavily
TAVILY_API_KEY=xxx

# App
THREAD_ID=xxx
GITHUB_TOKEN=xxx

# mcp agent
STOCK_AGENT_URL=http://stock-agent:8002

#vector store
QDRANT_URL=http://qdrant:6333
QDRANT_NEWS_COLLECTION=stock_news
QDRANT_PROFILE_COLLECTION=stock_profile
QDRANT_BUSINESS_BREAKDOWN_COLLECTION=stock_business_break_down

#cuda
CUDA_RERANK_URL=http://cuda_service:8000/api/v1/rerank
# 程序化调用凭证（JSON 数组）；sub 可指定该 client 代表的用户，admin=true 表示管理员权限
AUTH_CLIENT_CREDENTIALS=[{"client_id":"dashboard","client_secret":"xxx","sub":"u1","admin":true}]
