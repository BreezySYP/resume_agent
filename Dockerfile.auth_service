FROM python:3.11.15-trixie

RUN apt-get update && apt-get install -y gcc curl default-libmysqlclient-dev pkg-config && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 复制整个 workspace（uv 需要解析所有成员包）
COPY pyproject.toml uv.lock ./
COPY packages/shared ./packages/shared
COPY src ./src

RUN uv sync --package auth_service --no-dev

WORKDIR /app/src/auth_service
EXPOSE 8016
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8016"]
