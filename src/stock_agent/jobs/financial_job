from core.db import engine, insert_ignore
from data.coderule import add_prefix

 

FINANCIAL_MAP = {
    "归母净利润": "net_profit",
    "营业总收入": "revenue",
    "经营现金流量净额": "operating_cashflow",
    "净资产收益率(ROE)": "roe",
    "资产负债率": "asset_liability_ratio",
    "扣非净利润": "deduct_net_profit",
    "毛利率": "gross_margin",
    "销售净利率": "net_margin",
    "营业收入增长率": "revenue_growth",
    "归属母公司净利润增长率": "profit_growth",
    "总资产报酬率(ROA)": "roa",
    "每股收益": "eps",
    "每股净资产": "bvps",
    "每股经营现金流": "ocfps"
}

def transform_wide(df, code):

    date_cols = [c for c in df.columns if c not in ["选项", "指标"]]

    result = {}

    for _, row in df.iterrows():
        metric = row["指标"]

        if metric not in FINANCIAL_MAP:
            continue

        col_name = FINANCIAL_MAP[metric]

        for d in date_cols:
            value = row[d]

            if pd.isna(value):
                continue

            if (code, d) not in result:
                result[(code, d)] = {}

            result[(code, d)][col_name] = float(value)

    rows = []

    for (code, date), values in result.items():
        rows.append({
            "code": code,
            "report_date": date,
            **values
        })

    return pd.DataFrame(rows)

def financial_job(start_code: int = 0,end_code:int = 1000000):
    codes = [(r["code"], r["name"]) for r in ak.stock_info_a_code_name().to_dict("records")]
    codes = [(add_prefix(c[0]), c[1]) for c in codes if int(c[0]) >= start_code and int(c[0]) <= end_code]

    for code, name in codes:
        try:
            df = ak.stock_financial_abstract(symbol=code)
        except Exception as e:
            logger.error(f"[FETCH ERROR] {code}: {e}")
            time.sleep(120)
            continue
        df = transform_wide(df, code)
        df["name"] = name
        df.to_sql("financial_statement", con=engine, if_exists="append", index=False, method=insert_ignore)
        # print(df)
        # break
        # 防止触发频控
        time.sleep(random.uniform(2, 3))
        logger.info(f"saved {code} {name} to db")






if __name__ == "__main__":

    financial_job(160)

